# Used only by domain_assistant.py when generating real RAG answers.
# Copy this file to .env, then replace the placeholder value.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# To use Gemini instead, set GENERATOR_PROVIDER=gemini and fill GEMINI_API_KEY.
# Leave GENERATOR_PROVIDER=openai for the original lab setup.
GENERATOR_PROVIDER=openai
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
